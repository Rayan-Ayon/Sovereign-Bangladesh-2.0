-- 6. Anonymous Notification Inbox Table
-- Ensures anonymous users can track implementation status via handle + password
CREATE TABLE public.anonymous_notifications (
id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
recipient_profile_id UUID REFERENCES public.profiles(id) ON DELETE CASCADE NOT NULL,
proposal_id UUID REFERENCES public.proposals(id) ON DELETE CASCADE NOT NULL,
title VARCHAR(255) NOT NULL,
message TEXT NOT NULL,
blueprint_section_reference TEXT, -- e.g. "Page 42, Clause 3.1 of Logistics Chapter"
is_read BOOLEAN DEFAULT FALSE NOT NULL,
created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL
);
-- 7. Audit Log (Zero-Tampering Verification)
CREATE TABLE public.system_audit_logs (
id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
action VARCHAR(128) NOT NULL, -- e.g. "PROPOSAL_APPROVED_FOR_PR"
performed_by UUID REFERENCES public.profiles(id),
target_entity VARCHAR(64) NOT NULL,
target_id UUID NOT NULL,
payload JSONB NOT NULL,
created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL
);
-- ROW LEVEL SECURITY (RLS) POLICIES --
ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.proposals ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.proposal_comments ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.anonymous_notifications ENABLE ROW LEVEL SECURITY;
-- Profiles: Public can read anonymous handles and public badges; private credentials hidden
CREATE POLICY "Public profiles are viewable by everyone"
ON public.profiles FOR SELECT USING (true);
-- Proposals: Public read access
CREATE POLICY "Proposals are readable by everyone"
ON public.proposals FOR SELECT USING (true);
-- Proposals: Insert allowed for all authenticated and anonymous profile records
CREATE POLICY "Registered profiles can insert proposals"
ON public.proposals FOR INSERT WITH CHECK (auth.uid() = auth_user_id OR author_id IS NOT NULL);
-- Notifications: Only the owner profile can view its notifications
CREATE POLICY "Users can only read own notifications"
ON public.anonymous_notifications FOR SELECT
USING (recipient_profile_id = (SELECT id FROM public.profiles WHERE auth_user_id = auth.uid()));
