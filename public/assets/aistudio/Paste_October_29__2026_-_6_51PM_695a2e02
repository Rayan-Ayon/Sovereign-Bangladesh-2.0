    if (stepNumber === 3) {
      if (!formData.physics_limit_fix.trim()) {
        newErrors.physics_limit_fix = currentLocale === "bn" 
          ? "পদার্থবিজ্ঞান ভিত্তিক সমাধান ব্যাখ্যা করুন" 
