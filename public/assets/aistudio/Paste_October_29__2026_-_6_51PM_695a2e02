// Helper: Secure client-side SHA-256 for zero-trace anonymous auth passwords
async function hashPassphrase(passphrase: string, salt: string): Promise<string> {
  const enc = new TextEncoder();
  const data = enc.encode(passphrase + salt);
  const hashBuffer = await crypto.subtle.digest("SHA-256", data);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map((b) => b.toString(16).padStart(2, "0")).join("");
}

// Generate cryptographically sound anonymous handles
function generateAnonymousHandle(): string {
  const regions = ["BayBengal", "Padma", "Meghna", "Jamuna", "Karnaphuli", "Sundarbans", "Surma"];
  const randomRegion = regions[Math.floor(Math.random() * regions.length)];
  const randomHex = Math.floor(Math.random() * 0xffff)
    .toString(16)
    .toUpperCase()
    .padStart(4, "0");
  return `Anon-${randomRegion}-${randomHex}`;
}

