-- AI Evaluation & Semantic Clustering
ai_alignment_score NUMERIC(5, 2), -- 0.00 to 100.00 based on Trillion-Dollar alignment
ai_moderation_flag BOOLEAN DEFAULT FALSE,
ai_summary TEXT,
embedding VECTOR(1536), -- Vector representation for topic deduplication

upvotes_count INTEGER DEFAULT 0 NOT NULL,
comments_count INTEGER DEFAULT 0 NOT NULL,
created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW() NOT NULL,
