author_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL NOT NULL,
parent_comment_id UUID REFERENCES public.proposal_comments(id) ON DELETE CASCADE,
code
Code
content TEXT NOT NULL,
stance comment_stance_type DEFAULT 'nuance' NOT NULL,
technical_evidence_url TEXT,

is_flagged BOOLEAN DEFAULT FALSE,
