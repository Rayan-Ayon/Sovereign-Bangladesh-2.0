existing_bottleneck TEXT NOT NULL, -- What is broken / who benefits from corruption
hidden_root_cause TEXT NOT NULL, -- Inside operational ground truth
physics_limit_fix TEXT NOT NULL, -- How to execute at scientific minimum timeline (e.g. 10 days)
