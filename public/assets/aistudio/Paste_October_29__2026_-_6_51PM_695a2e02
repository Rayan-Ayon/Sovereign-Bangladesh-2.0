    setCurrentStep((prev) => Math.max(prev - 1, 1));
    window.scrollTo({ top: 120, behavior: "smooth" });
  };

  // ---------------------------------------------------------------------------
  // SUPABASE SUBMISSION HANDLER
  // ---------------------------------------------------------------------------
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!validateStep(4)) return;

    setIsSubmitting(true);
    setGeneralError(null);

    try {
      let authorProfileId: string;

      if (formData.identity_type === "anonymous") {
        // Generate cryptographic salt and hash
        const salt = "bd2_slt_" + Math.random().toString(36).substring(2, 10);
        const passwordHash = await hashPassphrase(formData.anonymous_passphrase, salt);

        // Check or create anonymous profile in Supabase
        const { data: existingProfile, error: profileFetchErr } = await supabase
          .from("profiles")
          .select("id")
          .eq("anonymous_handle", formData.anonymous_handle)
          .maybeSingle();

        if (profileFetchErr && profileFetchErr.code !== "PGRST116") {
          throw new Error(`Profile check failed: ${profileFetchErr.message}`);
        }

        if (existingProfile?.id) {
          authorProfileId = existingProfile.id;
        } else {
          const { data: newProfile, error: profileInsertErr } = await supabase
            .from("profiles")
            .insert({
              identity_type: "anonymous",
