    // Fetch active ministries from Supabase
    async function loadMinistries() {
      try {
        const { data, error } = await supabase
          .from("ministries")
          .select("id, slug, name_en, name_bn, target_10y_gdp_impact_usd")
          .order("target_10y_gdp_impact_usd", { ascending: false });

        if (!error && data && data.length > 0) {
          setMinistries(data as MinistryOption[]);
        }
      } catch {
        // Silently use defaults if offline / not seeded
      }
    }
    loadMinistries();
  }, []);

  // Update locale if URL param changes
  useEffect(() => {
    if (rawLocale === "bn" || rawLocale === "en") {
      setCurrentLocale(rawLocale);
    }
  }, [rawLocale]);

  const toggleLanguage = (lang: "en" | "bn") => {
    setCurrentLocale(lang);
    startTransition(() => {
      const currentPath = window.location.pathname;
      const newPath = currentPath.replace(/^\/(en|bn)/, `/${lang}`);
      router.replace(newPath);
    });
  };

  // ---------------------------------------------------------------------------
  // STEP VALIDATION
  // ---------------------------------------------------------------------------
  const validateStep = (stepNumber: number): boolean => {
    const newErrors: FormErrors = {};

    if (stepNumber === 1) {
      if (!formData.ministry_id.trim()) {
        newErrors.ministry_id = currentLocale === "bn" 
          ? "অনুগ্রহ করে একটি মন্ত্রণালয় বা খাত নির্বাচন করুন" 
          : "Please select a target ministry or sector";
      }
      if (!formData.title.trim()) {
        newErrors.title = currentLocale === "bn" 
          ? "প্রস্তাবনার শিরোনাম প্রদান করা আবশ্যক" 
          : "Proposal title is required";
      } else if (formData.title.length < 15) {
        newErrors.title = currentLocale === "bn" 
          ? "শিরোনাম কমপক্ষে ১৫ অক্ষরের হতে হবে" 
          : "Title must be at least 15 characters long";
      }
    }

    if (stepNumber === 2) {
      if (!formData.existing_bottleneck.trim()) {
        newErrors.existing_bottleneck = currentLocale === "bn" 
          ? "বিদ্যমান অচলাবস্থা বিস্তারিত ব্যাখ্যা করুন" 
